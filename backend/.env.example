PORT=3001
HOST=127.0.0.1
# Local defaults. Render: NODE_ENV=production; Render supplies PORT.
# Production ignores local HOST and binds to 0.0.0.0.
NODE_ENV=development
# Comma-separated exact frontend origins; no wildcard, path or trailing slash.
# Render: set to your actual Static Site HTTPS origin, plus custom origin if used.
FRONTEND_ORIGINS=http://127.0.0.1:5173,http://127.0.0.1:4173
# Optional. Backend only; never use a VITE_ prefix for a token.
GITHUB_TOKEN=
